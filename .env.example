# ── Required ──────────────────────────────────────────────
# Get your key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Password to open /dashboard — pick something strong
DASHBOARD_PASSWORD=change-me

# ── Optional: model & cost calculator ─────────────────────
# ANTHROPIC_MODEL=claude-sonnet-4-6
# PRICE_INPUT_PER_M=3.0
# PRICE_OUTPUT_PER_M=15.0
# HOSTING_USD_PER_MONTH=7
# PORT=3000

# ── Optional: where the SQLite file lives ─────────────────
# Leave unset for local dev (defaults to ./data.sqlite). In production set this to
# a path on a PERSISTENT disk so client data survives redeploys.
# Render (with the disk in render.yaml): /var/data/data.sqlite
# Docker / docker-compose (with the volume):           /data/data.sqlite
# DB_PATH=/var/data/data.sqlite

# ── Optional: rate limits & abuse protection ──────────────
# RATE_SESSION_PER_MIN=15
# RATE_IP_PER_MIN=120
# Failed dashboard-password attempts allowed per IP per minute (brute-force guard)
# RATE_AUTH_FAILS_PER_MIN=10

# ── Optional: cost guards ─────────────────────────────────
# Hard stop on API spend per day, in USD. When reached, the agent politely
# declines new chats until midnight instead of burning your Anthropic budget.
# Set to 0 to disable. Default: 3
# DAILY_BUDGET_USD=3
# Max messages per visitor session (each turn re-sends the whole conversation,
# so endless chats get increasingly expensive). Default: 60
# MAX_SESSION_MESSAGES=60

# ── Optional: data retention (privacy law compliance) ─────
# Personal data (conversations, leads, past appointments) is purged automatically
# after this many days. Default: 365. Set 0 to disable — NOT recommended:
# indefinite retention breaches GDPR art. 5.1.e and Paraguay's Ley 7593/2025.
# DATA_RETENTION_DAYS=365

# ── Optional: WhatsApp channel (customers chat with the agent on WhatsApp) ──
# The same AI that answers the website widget can also answer the business's
# WhatsApp number, via Meta's official WhatsApp Business Cloud API.
# Setup (once per client, ~30 min): developers.facebook.com → create app →
# add the "WhatsApp" product → get the permanent access token and the
# "Phone number ID" → set the webhook URL to
#   https://YOUR-DOMAIN/api/whatsapp/webhook
# with the verify token you invent below, and subscribe to "messages".
# The channel stays OFF until the first three are set.
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_VERIFY_TOKEN=any-string-you-invent
# Strongly recommended — lets the server verify each webhook really came from
# Meta (App settings → Basic → App secret):
# WHATSAPP_APP_SECRET=abc123...

# ── Optional: notification channels ───────────────────────
# Turn channels on/off and set recipients in business.config.json.
# The SECRETS for each enabled channel go here:

# Email (via Resend — sign up free at resend.com, create an API key)
# RESEND_API_KEY=re_...

# Telegram (message @BotFather to create a bot, paste its token here;
# get your chat id from @userinfobot and put it in business.config.json)
# TELEGRAM_BOT_TOKEN=123456:ABC...

# Webhook (any URL — Make.com, Zapier, Slack incoming webhook, your own server)
# NOTIFY_WEBHOOK_URL=https://hook.eu2.make.com/...
